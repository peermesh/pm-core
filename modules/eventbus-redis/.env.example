# Redis event bus provider configuration
EVENTBUS_REDIS_HOST=redis
EVENTBUS_REDIS_PORT=6379
EVENTBUS_STREAM_PREFIX=eventbus
EVENTBUS_MAX_DELIVERY_ATTEMPTS=5

# Redis password: pass the PATH of a mounted secret file, never the value.
# The provider refuses a group- or world-readable file and a symlink.
# EVENTBUS_REDIS_PASSWORD_FILE=/run/secrets/redis_password
